// Scrape at the poll interval: gasometer's metrics change once a minute, and Grafana Cloud bills per data point.
prometheus.scrape "gasometer" {
	targets         = [{"__address__" = "gasometer:9090"}]
	job_name        = "gasometer"
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// host tells the VM's series from a local compose stack's, which scrapes the same target under the same job.
prometheus.remote_write "grafana_cloud" {
	external_labels = {"host" = coalesce(sys.env("GASOMETER_HOST"), "gasometer")}

	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
			password = sys.env("GRAFANA_CLOUD_API_TOKEN")
		}
	}
}
