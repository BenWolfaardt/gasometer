      "panels": [
        {
          "type": "stat",
          "title": "Fee model mismatches",
          "description": "Polls where gasometer's next base fee differed from the node's. Expected 0.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "x": 0,
            "y": 29,
            "w": 8,
            "h": 5
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
              },
              "refId": "A",
              "expr": "sum by (network) (increase(gasometer_model_mismatch_total[$__range]))",
              "legendFormat": "{{network}}",
              "instant": true,
              "range": false
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "decimals": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
