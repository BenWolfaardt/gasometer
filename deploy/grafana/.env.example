# Copy to deploy/grafana/.env, which is gitignored, for install-alert.sh and make install-alerts.
# Kept apart from deploy/.env because compose hands that file to the Alloy container.

# e.g. https://<stack>.grafana.net
GRAFANA_URL=
# A service account token with the Admin role; Editor gets 403 on alert-rule provisioning.
GRAFANA_TOKEN=
# Connections > Data sources > open each one: the uid is the last part of the URL.
DATASOURCE_UID=
LOKI_DATASOURCE_UID=
