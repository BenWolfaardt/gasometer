# Copy to deploy/grafana/.env, which is gitignored, for make install-alerts.
# Kept apart from deploy/.env because compose hands that file to the Alloy container.

# Your stack's Grafana, e.g. https://<stack>.grafana.net
GRAFANA_URL=
# Grafana > Administration > Service accounts > add one with the Admin role > add a token (glsa_...).
# Not a Cloud access policy token: Editor or a policy token gets 403 on alert-rule provisioning.
GRAFANA_TOKEN=
# With the two above filled, list the data sources and take the uid of grafanacloud-<stack>-prom and -logs:
#   set -a; . deploy/grafana/.env; set +a
#   curl -sS -H "Authorization: Bearer $GRAFANA_TOKEN" "$GRAFANA_URL/api/datasources" | python3 -c 'import json,sys; [print(d["type"], d["name"], d["uid"]) for d in json.load(sys.stdin)]'
DATASOURCE_UID=grafanacloud-prom
LOKI_DATASOURCE_UID=grafanacloud-logs
