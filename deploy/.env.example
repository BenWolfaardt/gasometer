# Copy to deploy/.env, which is gitignored, and fill in every value.
POSTGRES_PASSWORD=

# Grafana Cloud > your stack > Prometheus > Details: the remote write endpoint, the username (instance ID), and an
# access policy token with the metrics:write and logs:write scopes. On the free tier, sharing a stack with the VM,
# leave the URL and user empty: two stacks' series exceed its 10,000.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_API_TOKEN=

# Grafana Cloud > your stack > Loki > Details: the push URL, ending /loki/api/v1/push, and the numeric user. The token
# above is reused. Left empty, Alloy keeps running and drops the log batches; metrics are unaffected.
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=

# Alloy reads container logs through the engine's socket, which also gives it control of the local engine. Docker's
# default needs nothing here; under Podman set CONTAINER_SOCKET=$XDG_RUNTIME_DIR/podman/podman.sock.
CONTAINER_SOCKET=
